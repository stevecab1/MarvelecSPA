{% load static %}{
    "id": "/panel/",
    "name": "MARVELEC SPA - Reporte de Avance",
    "short_name": "MARVELEC",
    "description": "Reporte y seguimiento de avance de obra eléctrica",
    "lang": "es-CL",
    "start_url": "/panel/",
    "scope": "/",
    "display": "standalone",
    "background_color": "#3a288f",
    "theme_color": "#3a288f",
    "categories": ["business", "productivity"],
    "icons": [
        { "src": "{% static 'marvelec_app/icons/icon-72x72.png' %}", "sizes": "72x72", "type": "image/png" },
        { "src": "{% static 'marvelec_app/icons/icon-96x96.png' %}", "sizes": "96x96", "type": "image/png" },
        { "src": "{% static 'marvelec_app/icons/icon-128x128.png' %}", "sizes": "128x128", "type": "image/png" },
        { "src": "{% static 'marvelec_app/icons/icon-144x144.png' %}", "sizes": "144x144", "type": "image/png" },
        { "src": "{% static 'marvelec_app/icons/icon-152x152.png' %}", "sizes": "152x152", "type": "image/png" },
        { "src": "{% static 'marvelec_app/icons/icon-192x192.png' %}", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "{% static 'marvelec_app/icons/icon-192x192.png' %}", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
        { "src": "{% static 'marvelec_app/icons/icon-384x384.png' %}", "sizes": "384x384", "type": "image/png" },
        { "src": "{% static 'marvelec_app/icons/icon-512x512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "{% static 'marvelec_app/icons/icon-512x512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "shortcuts": [
        {
            "name": "Nuevo reporte",
            "short_name": "Reportar",
            "url": "/panel/trabajador/nuevo/",
            "icons": [{ "src": "{% static 'marvelec_app/icons/icon-96x96.png' %}", "sizes": "96x96" }]
        },
        {
            "name": "Reportes por revisar",
            "short_name": "Por revisar",
            "url": "/panel/supervision/revisar/",
            "icons": [{ "src": "{% static 'marvelec_app/icons/icon-96x96.png' %}", "sizes": "96x96" }]
        }
    ]
}
